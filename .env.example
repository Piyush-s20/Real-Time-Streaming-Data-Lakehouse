# Copy to .env and adjust. docker compose and the Python jobs both read this file;
# variables already set in your shell take precedence.

# Kafka broker address used by the producer and the Bronze job (from the host)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO endpoint and credentials. docker-compose.yml also uses the key pair as the
# MinIO root user (the secret must be at least 8 characters).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123

# Airflow web UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Windows only: the folder that contains bin\winutils.exe
# HADOOP_HOME=C:\hadoop

# Where the streaming jobs append their per-batch progress (default: metrics/ in the repo root)
# METRICS_DIR=metrics
